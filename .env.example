# ==========================================
# MUSE2API config example / 配置环境变量示例
# Copy to .env to take effect: cp .env.example .env
# 复制为 .env 即可生效: cp .env.example .env
# Docs in English by default, 中文对照在后. UI language: MUSE2API_LANG=en|zh
# ==========================================

# [required/optional] Admin + API auth key (must start with m2a_).
# [必填/选填] 管理与 API 鉴权密钥（以 m2a_ 开头）。
# If empty, a strong random key is auto-generated on first boot and printed to console.
# 若留空，程序首次启动时会自动生成一个高强度随机密钥并打印到控制台日志。
MUSE2API_KEY=m2a_your_secret_admin_key_here

# UI/backend language: en (default) | zh. Frontend admin page has its own toggle.
# 界面语言：en（默认）| zh，管理页另有独立切换按钮。
MUSE2API_LANG=en

# Listen address + port (use 0.0.0.0 inside Docker).
# 服务监听地址与端口（Docker 容器内需设为 0.0.0.0）
MUSE2API_HOST=0.0.0.0
MUSE2API_PORT=18610

# Public base URL for downstream clients + admin page links, e.g. https://api.yourdomain.com
# 外部公开访问地址（供下游客户端接入及管理页拼接使用，如 https://api.yourdomain.com）
# Empty = admin page auto-detects current browser host/port.
# 留空时，管理页面将自动使用当前浏览器访问的主机与端口
MUSE2API_PUBLIC_BASE=

# Chromium executable path.
# Chromium 浏览器可执行文件路径
# Linux/Docker is usually /usr/bin/chromium or /usr/bin/chromium-browser.
# Linux/Docker 通常为 /usr/bin/chromium 或 /usr/bin/chromium-browser
# On Windows set full Chrome path or leave empty for auto-detect.
# Windows 本地运行可设为 Chrome 完整路径或留空自动查找
MUSE2API_CHROMIUM=/usr/bin/chromium

# CDP remote-debugging port / CDP 远程调试通信端口
MUSE2API_CDP_PORT=19210

# Task timeouts (seconds) / 任务超时控制（单位：秒）
MUSE2API_IMAGE_TIMEOUT=240
MUSE2API_VIDEO_TIMEOUT=600
MUSE2API_CHAT_TIMEOUT=300

# Max concurrent generation tasks (raise freely with server resources, default 2).
# 最大并发生成任务数（支持随服务器资源自由调高，默认 2）
MUSE2API_CONCURRENCY=2

# Auto-keepalive for disabled accounts (0=off, 1=on).
# 是否对后台禁用的账号执行自动保活（0=关闭，1=开启）
# When on, disabled accounts still get silent keepalive/session renewal but never join rotation.
# 开启后已禁用账号仍会执行静默保活与会话续期，但不会被路由参与正常生成与对话
MUSE2API_KEEPALIVE_DISABLED_ACCOUNTS=0
